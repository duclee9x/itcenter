[Unit]
Description=IT Operations Hub Docker Compose production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/itcenter/deploy
EnvironmentFile=/etc/itcenter/production/compose.env
ExecStart=/opt/itcenter/deploy/scripts/start-current.sh production /etc/itcenter/production/compose.env
ExecStop=/opt/itcenter/deploy/scripts/stop-stack.sh production /etc/itcenter/production/compose.env
TimeoutStartSec=0
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
