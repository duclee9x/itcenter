[Unit]
Description=IT Operations Hub Podman Compose production stack
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/itcenter/deploy
Environment=CONTAINER_CLI=podman
Environment=DEPLOY_STATE_ROOT=%h/.local/state/itcenter/release-state
Environment=DEPLOY_LOCK_ROOT=%h/.local/state/itcenter/locks
EnvironmentFile=%h/.config/itcenter/production/compose.env
ExecStart=/opt/itcenter/deploy/scripts/start-current.sh production %h/.config/itcenter/production/compose.env
ExecStop=/opt/itcenter/deploy/scripts/stop-stack.sh production %h/.config/itcenter/production/compose.env
TimeoutStartSec=0
TimeoutStopSec=20

[Install]
WantedBy=default.target
