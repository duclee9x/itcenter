[Unit]
Description=IT Center protected PostgreSQL backup
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/itcenter/backup.env
ExecStart=/bin/bash -c 'exec "$ITCENTER_DEPLOY_ROOT/scripts/backup.sh" "$ITCENTER_BACKUP_ENVIRONMENT" "$ITCENTER_ENV_FILE" --reason scheduled'
