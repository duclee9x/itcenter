# Copy to a protected host-local .env file and replace all example values.
COMPOSE_PROJECT_NAME=itsm-staging
APP_ENV=staging
APP_IMAGE=registry.example.invalid/itcenter/app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
APP_VERSION=0.0.0
GIT_COMMIT=unknown
BUILD_TIME=unknown
IMAGE_DIGEST=
RUNTIME_ENV_FILE=/home/itcenter/.config/itcenter/staging/runtime.env
DB_MODE=external
POSTGRES_IMAGE=docker.io/library/postgres@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
CADDY_IMAGE=docker.io/library/caddy@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
POSTGRES_DB=itcenter_staging
POSTGRES_USER=itcenter_staging
DATABASE_URL_FILE=/home/itcenter/.config/itcenter/staging/secrets/database-url
POSTGRES_PASSWORD_FILE=/home/itcenter/.config/itcenter/staging/secrets/postgres-password
AGENT_TLS_CERT_FILE=/home/itcenter/.config/itcenter/staging/secrets/agent-server-cert.pem
AGENT_TLS_KEY_FILE=/home/itcenter/.config/itcenter/staging/secrets/agent-server-key.pem
AGENT_CA_CERT_FILE=/home/itcenter/.config/itcenter/staging/secrets/agent-ca-cert.pem
AGENT_GATEWAY_HEALTH_CA_FILE=/home/itcenter/.config/itcenter/staging/secrets/agent-ca-cert.pem
AGENT_CA_SIGNING_KEY_FILE=/home/itcenter/.config/itcenter/staging/secrets/agent-ca-key.pem
AGENT_CA_SIGNING_PASSPHRASE_FILE=/home/itcenter/.config/itcenter/staging/secrets/agent-ca-passphrase
API_TLS_CERT_FILE=/home/itcenter/.config/itcenter/staging/secrets/api-cert.pem
API_TLS_KEY_FILE=/home/itcenter/.config/itcenter/staging/secrets/api-key.pem
AUTH_MODE=oidc
OIDC_ISSUER=https://idp-staging.example.invalid
OIDC_AUDIENCE=itcenter-staging-api
AGENT_AUTH_MODE=mtls
API_HOSTNAME=itcenter-staging.example.invalid
STAGING_API_BIND_ADDRESS=127.0.0.1
STAGING_HTTP_PORT=18080
STAGING_HTTPS_PORT=18443
AGENT_BIND_ADDRESS=0.0.0.0
AGENT_HOST_PORT=13001
API_HEALTH_URL=https://itcenter-staging.example.invalid:18443/api/v1/health/ready
API_HEALTH_RESOLVE=itcenter-staging.example.invalid:18443:127.0.0.1
AGENT_GATEWAY_HOSTNAME=agent-staging.example.invalid
AGENT_GATEWAY_HEALTH_URL=https://agent-staging.example.invalid:13001/api/v1/health/ready
AGENT_GATEWAY_HEALTH_RESOLVE=agent-staging.example.invalid:13001:127.0.0.1
# Optional mTLS authentication probe uses an enrolled, non-production Agent identity.
# AGENT_MTLS_SMOKE_URL=https://agent-staging.example.invalid:13001/api/v1/agent/__release_smoke_auth_probe__
# AGENT_MTLS_SMOKE_CERT_FILE=/home/itcenter/.config/itcenter/staging/secrets/agent-smoke-cert.pem
# AGENT_MTLS_SMOKE_KEY_FILE=/home/itcenter/.config/itcenter/staging/secrets/agent-smoke-key.pem
SMOKE_TIMEOUT_SECONDS=180
PRODUCTION_APPROVAL_REF=NOT_APPLICABLE_STAGING
PRE_MIGRATION_BACKUP_REF=NOT_APPLICABLE_STAGING
# Optional protected API smoke inputs (file contains a short-lived staging token).
# SMOKE_BEARER_TOKEN_FILE=/home/itcenter/.config/itcenter/staging/secrets/smoke-token
# SMOKE_TENANT_ID=staging-smoke-tenant
# SMOKE_PROTECTED_URL=https://127.0.0.1:8443/api/v1/health/capabilities
