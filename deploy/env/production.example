# Copy to a protected host-local .env file and replace all example values.
COMPOSE_PROJECT_NAME=itsm-production
APP_ENV=production
APP_IMAGE=registry.example.invalid/itcenter/app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
APP_VERSION=0.0.0
GIT_COMMIT=unknown
BUILD_TIME=unknown
IMAGE_DIGEST=
RUNTIME_ENV_FILE=/home/itcenter/.config/itcenter/production/runtime.env
DB_MODE=external
POSTGRES_IMAGE=docker.io/library/postgres@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
CADDY_IMAGE=docker.io/library/caddy@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
CADDY_CONFIG_FILE=./caddy/Caddyfile.production
CADDY_CERT_MODE=acme
POSTGRES_DB=itcenter_production
POSTGRES_USER=itcenter_production
DATABASE_URL_FILE=/home/itcenter/.config/itcenter/production/secrets/database-url
POSTGRES_PASSWORD_FILE=/home/itcenter/.config/itcenter/production/secrets/postgres-password
AGENT_TLS_CERT_FILE=/home/itcenter/.config/itcenter/production/secrets/agent-server-cert.pem
AGENT_TLS_KEY_FILE=/home/itcenter/.config/itcenter/production/secrets/agent-server-key.pem
AGENT_CA_CERT_FILE=/home/itcenter/.config/itcenter/production/secrets/agent-ca-cert.pem
AGENT_GATEWAY_HEALTH_CA_FILE=/home/itcenter/.config/itcenter/production/secrets/agent-ca-cert.pem
AGENT_CA_SIGNING_KEY_FILE=/home/itcenter/.config/itcenter/production/secrets/agent-ca-key.pem
AGENT_CA_SIGNING_PASSPHRASE_FILE=/home/itcenter/.config/itcenter/production/secrets/agent-ca-passphrase
API_TLS_CERT_FILE=/home/itcenter/.config/itcenter/production/secrets/api-cert.pem
API_TLS_KEY_FILE=/home/itcenter/.config/itcenter/production/secrets/api-key.pem
AUTH_MODE=oidc
OIDC_ISSUER=https://idp.example.invalid
OIDC_AUDIENCE=itcenter-api
AGENT_AUTH_MODE=mtls
API_HOSTNAME=itcenter.example.invalid
PRODUCTION_API_BIND_ADDRESS=0.0.0.0
PRODUCTION_HTTP_PORT=8080
PRODUCTION_HTTPS_PORT=8443
AGENT_BIND_ADDRESS=0.0.0.0
AGENT_HOST_PORT=3001
API_HEALTH_URL=https://itcenter.example.invalid:8443/api/v1/health/ready
API_HEALTH_RESOLVE=itcenter.example.invalid:8443:127.0.0.1
API_HTTP_REDIRECT_URL=http://itcenter.example.invalid/api/v1/health/ready
AGENT_GATEWAY_HOSTNAME=agent.example.invalid
AGENT_GATEWAY_HEALTH_URL=https://agent.example.invalid:3001/api/v1/health/ready
AGENT_GATEWAY_HEALTH_RESOLVE=agent.example.invalid:3001:127.0.0.1
# Optional smoke identity must be an explicitly provisioned, restricted production Agent.
# AGENT_MTLS_SMOKE_URL=https://agent.example.invalid:3001/api/v1/agent/__release_smoke_auth_probe__
# AGENT_MTLS_SMOKE_CERT_FILE=/home/itcenter/.config/itcenter/production/secrets/agent-smoke-cert.pem
# AGENT_MTLS_SMOKE_KEY_FILE=/home/itcenter/.config/itcenter/production/secrets/agent-smoke-key.pem
SMOKE_TIMEOUT_SECONDS=180
PRODUCTION_APPROVAL_REF=REPLACE_WITH_APPROVAL_OR_CHANGE_REFERENCE
GUEST_BACKUP_MOUNT=/mnt/host-backups/itcenter
LIMA_WORK_DIR=/home/itcenter/.local/state/itcenter/backups/work
BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_RECIPIENT
BACKUP_MOUNT_FSTYPES=virtiofs,9p
BACKUP_ESCROW_AGE_IDENTITY_REF=REPLACE_WITH_PROTECTED_AGE_IDENTITY_ESCROW_REFERENCE
BACKUP_ESCROW_AGENT_CA_REF=REPLACE_WITH_PROTECTED_AGENT_CA_ESCROW_REFERENCE
POSTGRES_MAJOR_VERSION=18
# Optional protected API smoke inputs (file contains a short-lived production-safe token).
# SMOKE_BEARER_TOKEN_FILE=/home/itcenter/.config/itcenter/production/secrets/smoke-token
# SMOKE_TENANT_ID=approved-smoke-tenant
# SMOKE_PROTECTED_URL=https://127.0.0.1/api/v1/health/capabilities
