APP_ENV=local
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_SECRET_REF=env:ITCENTER_DATABASE_URL
# IdP must issue signed OIDC auth_time, acr, and amr claims; map this ACR to MFA.
NETWORK_CHANGE_REQUIRED_ACR=urn:itcenter:acr:mfa
NETWORK_CHANGE_MAX_AUTH_AGE_SECONDS=300
# Live device configuration stays disabled until a vendor/model adapter is wired.
# Local Podman may publish PostgreSQL on 15432; use the port reported by
# `podman port itcenter-postgres 5432/tcp` when setting this URL.
# Set ITCENTER_DATABASE_URL outside tracked files.
# Production: file:/run/secrets/itcenter-database-url mounted by your secret manager.
