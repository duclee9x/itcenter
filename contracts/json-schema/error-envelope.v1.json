{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["error", "meta"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "details", "retryable"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["request_id", "correlation_id"],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        }
      }
    }
  }
}
